# ============================================
# FRONTEND ENV — apps/web/.env
# Estas variables son PUBLICAS (van al bundle)
# ============================================

# Supabase (Auth)
# Obtén en: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Backend API
# URL de tu backend en Render (ej: https://raven-api.onrender.com)
VITE_API_URL=http://localhost:3000

# Stripe (Publishable key — pública)
# Obtén en: Stripe Dashboard → Developers → API Keys → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
